# Copie para .env e preencha. O Makefile exporta estas variáveis para a aplicação.

# Braços de fronteira (Seção 4.4)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# brapi.dev — plano gratuito exige token (https://brapi.dev/dashboard)
BRAPI_TOKEN=

# Braço local via Ollama.
# Se gemma4:e4b ainda não estiver no registry do Ollama, use gemma3n:e4b.
OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# Modelos de fronteira (fixe versões para reprodutibilidade do experimento)
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# Reranker BGE-reranker-v2-m3 servido pelo TEI (docker compose)
TEI_URL=http://localhost:8081

# Imagem do TEI conforme a arquitetura do host (manifestos separados na HF):
#   Apple Silicon / aarch64 -> ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9
#   x86_64                  -> ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9

# Extração automática ao indexar (false = disparo manual via API, controla custo)
EXTRACTION_AUTO=false
EXTRACTION_PROVIDERS=CLAUDE_SONNET,GPT_4O,GEMMA
