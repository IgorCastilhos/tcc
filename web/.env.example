# Modo do carregamento de dados (ver web/src/lib/api.ts).
#
# Vazio  -> mesma origem: a interface é servida pelo Spring em localhost:8080
#           e chama /api/panel ao vivo. É o padrão do 'make web'.
# URL    -> aponta para um backend em outra origem (dev com 'npm run dev' já
#           usa o proxy do Vite, então normalmente não precisa disso).
VITE_API_BASE=

# 1 = modo congelado: ignora a API e lê public/data/panel.json.
# É o que a publicação para os participantes usa (ver vercel.json).
VITE_SNAPSHOT=
